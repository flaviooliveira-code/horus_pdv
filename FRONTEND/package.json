{
  "name": "horuspdv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dev": "vite --mode development",
    "dev:prod": "vite --mode prod",
    "build": "tsc -b && vite build --mode prod",
    "build:dev": "tsc -b && node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && vite build --mode development",
    "build:prod": "tsc -b && node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && vite build --mode prod",
    "lint": "eslint .",
    "preview": "vite preview",
    "smoke": "playwright test --config playwright.config.ts",
    "smoke:headed": "playwright test --config playwright.config.ts --headed",
    "smoke:keep": "SMOKE_RUN_ID=SMOKE_CONFERE SMOKE_KEEP_DATA=1 playwright test --config playwright.config.ts --headed",
    "smoke:install": "playwright install chromium",
    "demo:video": "playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7"
  },
  "engines": {
    "node": ">=24"
  }
}
